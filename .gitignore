# Reference clones used while researching the community themes and HanaAgent.
# Roughly 230 MB, and deliberately excluded from the Nix flake source so that
# `nix develop` / `nix flake check` do not copy it into the store on every run.
.research/

# Nix
result
result-*
.nix-cache/

# pnpm (both are redirected into the tree by the dev shell)
.pnpm/
.pnpm-store/
node_modules/

*.log

# Uncompressed screenshot originals. `assets/` holds the q92 WebP derivatives
# that the READMEs reference; these PNGs are 10 MB and add nothing.
assests/

# Local diagnostic dumps (a one-off view of THIS machine's settings surface,
# not something a published theme should ship).
test/settings-probe.json

# Verification scaffolding is source and IS committed; its generated outputs are
# not. shiki-probe.html embeds a whole palette plus the harness's stylesheets,
# and probe.png is a screenshot of this machine's fonts — neither belongs in the
# repo, and both are one command away (see test/verify/build-shiki-probe.mjs).
test/verify/shiki-probe.html
test/verify/probe.png

# The render BASELINE is committed on purpose: it is the record of what a real
# engine resolved, so a drift shows up as a reviewable git diff. Everything
# above is regenerable output; this is evidence.

# A throwaway Firefox profile, created in-tree so headless rendering works in a
# sandbox with no writable HOME.
.verify-profile/
test/verify/surface-probe.html
test/verify/surface-probe.png
test/verify/seal-probe-soft.png
test/verify/seal-probe-seal.png
